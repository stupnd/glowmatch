ANTHROPIC_API_KEY=your_key_here
REMOVEBG_API_KEY=your_key_here

# Comma-separated origins allowed to call this API. Unset = localhost only.
# Set this to your deployed frontend origin before going public.
ALLOWED_ORIGINS=https://your-app.vercel.app

# Hard ceiling on estimated spend per UTC day, across Claude + remove.bg.
# Paid endpoints return 503 once this is crossed.
DAILY_BUDGET_USD=5.00

# Upload limits
MAX_UPLOAD_BYTES=8388608
MAX_IMAGE_PIXELS=12000000

# Pricing used to estimate spend. Update if the model or remove.bg plan changes.
CLAUDE_INPUT_PER_MTOK=3.00
CLAUDE_OUTPUT_PER_MTOK=15.00
REMOVEBG_COST_PER_CALL=0.09
